TZ=UTC
PORT=3333
HOST=0.0.0.0
LOG_LEVEL=info
# Genera uno con: node ace generate:key --show
APP_KEY=
NODE_ENV=development
# URL pública de este backend (en Railway: https://<servicio>.up.railway.app)
APP_URL=http://localhost:3333
# URL(s) del frontend separadas por coma. Vacío = cualquier origen
CORS_ORIGIN=http://localhost:5173

# Local: DB_*   |   Railway: DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_DATABASE=tours
DB_SSL=false

# fs = carpeta ./storage (local) | s3 = Railway Bucket
DRIVE_DISK=fs
# Railway Bucket (referenciar variables del bucket: ${{Bucket.BUCKET}}, etc.)
BUCKET=
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
REGION=auto
ENDPOINT=
S3_FORCE_PATH_STYLE=false

# Administrador inicial creado por el seeder
ADMIN_EMAIL=admin@tudominio.com
ADMIN_PASSWORD=CambiaEstaClave123
# Crear datos de ejemplo la primera vez (true/false)
SEED_DEMO=true
